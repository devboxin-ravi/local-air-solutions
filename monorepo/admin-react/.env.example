# API base URL (backend-node). Must include the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public origin of the backend (used to resolve uploaded file URLs)
VITE_ASSET_BASE_URL=http://localhost:8000

# Application
VITE_APP_NAME=Local Air Solutions
VITE_APP_VERSION=1.0.0

# Optional: Google Maps JavaScript/Embed key (restricted by HTTP referrer). Maps fall back to links when empty.
VITE_GOOGLE_MAPS_KEY=
