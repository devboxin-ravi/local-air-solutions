# ─── Application ───
NODE_ENV=development
APP_NAME=Local Air Solutions API
APP_VERSION=1.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000

# ─── Database (MySQL 8+) ───
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/local_air_solutions

# ─── Auth / Security ───
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30
# Admin-panel sign-ins expire this many days after login (token refresh does not extend it)
JWT_ADMIN_SESSION_DAYS=7
JWT_ISSUER=local-air-solutions
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OTP_ENABLED=false
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─── HTTP ───
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# ─── Uploads ───
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=8

# ─── SMTP email (optional — email channel is disabled until filled) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Local Air Solutions <no-reply@example.com>

# ─── Razorpay (optional — gateway disabled until filled) ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Encrypts integration secrets saved from the admin panel (Razorpay keys). 32+ random chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

# ─── WhatsApp Business Cloud API (future — keep false until Meta verification) ───
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ─── Firebase Cloud Messaging (optional — push disabled until filled) ───
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─── Background jobs ───
JOBS_ENABLED=true
REMINDER_CRON=0 8 * * *
NOTIFICATION_CRON=*/2 * * * *

# ─── Seed (first Super Admin) ───
SEED_ADMIN_EMAIL=admin@developerbox.sbs
SEED_ADMIN_MOBILE=9340515586
SEED_ADMIN_PASSWORD=Local@2026
