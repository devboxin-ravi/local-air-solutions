// Local Air Solutions — HVAC Service Management ERP
// MySQL 8+ / Prisma ORM. Money is always DECIMAL(12,2). Historical records are never hard-deleted.

generator client {
  provider      = "prisma-client-js"
  // node:20-alpine ships OpenSSL 3; without this target Prisma loads openssl-1.1 and crashes.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserType {
  ADMIN
  STAFF
  CUSTOMER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  REGISTRATION
  JOB_COMPLETION
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum PricingType {
  FIXED
  STARTING
  QUOTATION
  FREE
}

enum BookingType {
  SERVICE
  REPAIR
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_VERIFICATION
  CONFIRMED
  ASSIGNED
  ACCEPTED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  RESCHEDULED
}

enum BookingSource {
  ADMIN
  CUSTOMER_APP
  AMC
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum AttachmentKind {
  BEFORE
  AFTER
  CUSTOMER_UPLOAD
  PAYMENT_PROOF
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  UPI_MANUAL
  CASH
  BANK_TRANSFER
}

enum PaymentRecordStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  REFUNDED
  FAILED
}

enum LedgerEntryType {
  OPENING_BALANCE
  INVOICE
  PAYMENT
  REFUND
  ADJUSTMENT
  REVERSAL
}

enum AmcStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  EXPIRING
  EXPIRED
  CANCELLED
}

enum AmcVisitStatus {
  SCHEDULED
  BOOKED
  COMPLETED
  MISSED
  CANCELLED
}

enum ReminderType {
  SERVICE
  AMC
}

enum ReminderStatus {
  UPCOMING
  DUE
  OVERDUE
  COMPLETED
  DISMISSED
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// ───────────────────────── Identity & Access ─────────────────────────

model User {
  id               Int           @id @default(autoincrement())
  name             String        @db.VarChar(100)
  email            String?       @unique @db.VarChar(254)
  /// Optional staff login name (lowercase, unique); mobile/email also sign in.
  username         String?       @unique @db.VarChar(30)
  countryCode      String        @default("+91") @map("country_code") @db.VarChar(5)
  mobile           String        @unique @db.VarChar(15)
  passwordHash     String?       @map("password_hash") @db.VarChar(255)
  userType         UserType      @map("user_type")
  status           AccountStatus @default(ACTIVE)
  branchId         Int?          @map("branch_id")
  avatarUrl        String?       @map("avatar_url") @db.VarChar(500)
  failedLoginCount Int           @default(0) @map("failed_login_count")
  lockedUntil      DateTime?     @map("locked_until")
  lastLoginAt      DateTime?     @map("last_login_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  branch          Branch?               @relation(fields: [branchId], references: [id])
  roles           UserRole[]
  refreshTokens   RefreshToken[]
  otpCodes        OtpCode[]
  staffProfile    StaffProfile?
  customer        Customer?
  notifications   Notification[]
  deviceTokens    DeviceToken[]
  auditLogs       AuditLog[]
  statusChanges   BookingStatusHistory[]
  jobNotes        JobNote[]
  attachments     JobAttachment[]

  @@index([userType, status])
  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          Int    @id @default(autoincrement())
  code        String @unique @db.VarChar(100)
  module      String @db.VarChar(50)
  action      String @db.VarChar(20)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  familyId   String    @map("family_id") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy Int?      @map("replaced_by")
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OtpCode {
  id         Int        @id @default(autoincrement())
  userId     Int        @map("user_id")
  purpose    OtpPurpose
  codeHash   String     @map("code_hash") @db.VarChar(128)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(500)
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

// ───────────────────────── Master Data ─────────────────────────

model State {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(10)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cities    City[]
  addresses CustomerAddress[]

  @@map("states")
}

model City {
  id        Int      @id @default(autoincrement())
  stateId   Int      @map("state_id")
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  state     State             @relation(fields: [stateId], references: [id])
  branches  Branch[]
  addresses CustomerAddress[]

  @@unique([stateId, name])
  @@map("cities")
}

model Branch {
  id        Int      @id @default(autoincrement())
  cityId    Int      @map("city_id")
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  address   String?  @db.VarChar(500)
  phone     String?  @db.VarChar(15)
  email     String?  @db.VarChar(254)
  gstin     String?  @db.VarChar(15)
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city           City                @relation(fields: [cityId], references: [id])
  serviceAreas   ServiceArea[]
  users          User[]
  staff          StaffProfile[]
  customers      Customer[]
  bookings       ServiceBooking[]
  slots          AppointmentSlot[]
  invoices       Invoice[]
  amcContracts   AmcContract[]
  serviceLinks   ServiceBranch[]
  pricing        ServicePricing[]
  stockItems StockItem[]

  @@map("branches")
}

model ServiceArea {
  id        Int      @id @default(autoincrement())
  branchId  Int      @map("branch_id")
  name      String   @db.VarChar(100)
  pincodes  String?  @db.VarChar(1000)
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  radiusKm  Decimal? @map("radius_km") @db.Decimal(6, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch    Branch             @relation(fields: [branchId], references: [id])
  staff     StaffServiceArea[]
  addresses CustomerAddress[]

  @@unique([branchId, name])
  @@map("service_areas")
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  technicians TechnicianSkill[]
  services    ServiceSkill[]

  @@map("skills")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  category  String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookings ServiceBooking[]

  @@map("products")
}

/// Branch-wise spare parts / material that can be billed on invoices.
model StockItem {
  id            Int      @id @default(autoincrement())
  branchId      Int      @map("branch_id")
  code          String   @db.VarChar(30)
  name          String   @db.VarChar(100)
  unit          String   @default("PCS") @db.VarChar(20)
  hsnCode       String?  @map("hsn_code") @db.VarChar(20)
  salePrice     Decimal  @default(0) @map("sale_price") @db.Decimal(12, 2)
  gstRate       Decimal  @default(18) @map("gst_rate") @db.Decimal(5, 2)
  quantity      Int      @default(0)
  lowStockLevel Int      @default(0) @map("low_stock_level")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  branch       Branch        @relation(fields: [branchId], references: [id])
  invoiceItems InvoiceItem[]

  @@unique([branchId, code])
  @@map("stock_items")
}

// ───────────────────────── Staff ─────────────────────────

model StaffProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  staffCode       String   @unique @map("staff_code") @db.VarChar(20)
  designation     String?  @db.VarChar(100)
  branchId        Int      @map("branch_id")
  experienceYears Int      @default(0) @map("experience_years")
  workStartTime   String   @default("09:00") @map("work_start_time") @db.VarChar(5)
  workEndTime     String   @default("18:00") @map("work_end_time") @db.VarChar(5)
  isAvailable     Boolean  @default(true) @map("is_available")
  isTechnician    Boolean  @default(true) @map("is_technician")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user         User                   @relation(fields: [userId], references: [id])
  branch       Branch                 @relation(fields: [branchId], references: [id])
  skills       TechnicianSkill[]
  serviceAreas StaffServiceArea[]
  assignments  TechnicianAssignment[]

  @@index([branchId, isAvailable])
  @@map("staff_profiles")
}

model TechnicianSkill {
  staffId Int @map("staff_id")
  skillId Int @map("skill_id")

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  skill Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([staffId, skillId])
  @@map("technician_skills")
}

model StaffServiceArea {
  staffId       Int @map("staff_id")
  serviceAreaId Int @map("service_area_id")

  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceArea ServiceArea  @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceAreaId])
  @@map("staff_service_areas")
}

// ───────────────────────── Customers ─────────────────────────

model Customer {
  id                     Int           @id @default(autoincrement())
  customerCode           String        @unique @map("customer_code") @db.VarChar(20)
  userId                 Int?          @unique @map("user_id")
  fullName               String        @map("full_name") @db.VarChar(100)
  countryCode            String        @default("+91") @map("country_code") @db.VarChar(5)
  mobile                 String        @db.VarChar(15)
  email                  String?       @db.VarChar(254)
  alternateMobile        String?       @map("alternate_mobile") @db.VarChar(15)
  branchId               Int?          @map("branch_id")
  customerType           CustomerType  @default(INDIVIDUAL) @map("customer_type")
  status                 AccountStatus @default(ACTIVE)
  notes                  String?       @db.VarChar(1000)
  reminderIntervalMonths Int?          @map("reminder_interval_months")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  deletedAt              DateTime?     @map("deleted_at")

  user         User?              @relation(fields: [userId], references: [id])
  branch       Branch?            @relation(fields: [branchId], references: [id])
  addresses    CustomerAddress[]
  bookings     ServiceBooking[]
  invoices     Invoice[]
  payments     Payment[]
  ledger       CustomerLedger[]
  amcContracts AmcContract[]
  reminders    ServiceReminder[]

  @@index([mobile])
  @@index([fullName])
  @@index([branchId])
  @@map("customers")
}

model CustomerAddress {
  id            Int      @id @default(autoincrement())
  customerId    Int      @map("customer_id")
  label         String   @default("Home") @db.VarChar(50)
  line1         String   @db.VarChar(500)
  line2         String?  @db.VarChar(500)
  landmark      String?  @db.VarChar(200)
  stateId       Int      @map("state_id")
  cityId        Int      @map("city_id")
  serviceAreaId Int?     @map("service_area_id")
  pincode       String   @db.VarChar(6)
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  isDefault     Boolean  @default(false) @map("is_default")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer     Customer         @relation(fields: [customerId], references: [id])
  state        State            @relation(fields: [stateId], references: [id])
  city         City             @relation(fields: [cityId], references: [id])
  serviceArea  ServiceArea?     @relation(fields: [serviceAreaId], references: [id])
  bookings     ServiceBooking[]
  amcContracts AmcContract[]

  @@index([customerId])
  @@index([pincode])
  @@map("customer_addresses")
}

// ───────────────────────── Service Catalogue ─────────────────────────

model ServiceCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(2000)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  icon        String?  @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services Service[]

  @@map("service_categories")
}

model Service {
  id                     Int         @id @default(autoincrement())
  categoryId             Int         @map("category_id")
  code                   String      @unique @db.VarChar(30)
  name                   String      @db.VarChar(100)
  description            String?     @db.VarChar(2000)
  imageUrl               String?     @map("image_url") @db.VarChar(500)
  durationMinutes        Int         @default(60) @map("duration_minutes")
  pricingType            PricingType @default(FIXED) @map("pricing_type")
  basePrice              Decimal     @default(0) @map("base_price") @db.Decimal(12, 2)
  gstApplicable          Boolean     @default(true) @map("gst_applicable")
  gstRate                Decimal     @default(18) @map("gst_rate") @db.Decimal(5, 2)
  reminderEligible       Boolean     @default(false) @map("reminder_eligible")
  reminderIntervalMonths Int?        @map("reminder_interval_months")
  isPopular              Boolean     @default(false) @map("is_popular")
  sortOrder              Int         @default(0) @map("sort_order")
  isActive               Boolean     @default(true) @map("is_active")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  category     ServiceCategory      @relation(fields: [categoryId], references: [id])
  skills       ServiceSkill[]
  branches     ServiceBranch[]
  pricing      ServicePricing[]
  bookingItems BookingItem[]
  invoiceItems InvoiceItem[]
  amcServices  AmcContractService[]
  reminders    ServiceReminder[]

  @@index([categoryId, isActive])
  @@index([name])
  @@map("services")
}

model ServiceSkill {
  serviceId Int @map("service_id")
  skillId   Int @map("skill_id")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([serviceId, skillId])
  @@map("service_skills")
}

model ServiceBranch {
  serviceId Int @map("service_id")
  branchId  Int @map("branch_id")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([serviceId, branchId])
  @@map("service_branches")
}

/// Branch-specific price overrides with effective dating. History is preserved.
model ServicePricing {
  id            Int       @id @default(autoincrement())
  serviceId     Int       @map("service_id")
  branchId      Int?      @map("branch_id")
  price         Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id])

  @@index([serviceId, branchId])
  @@map("service_pricing")
}

// ───────────────────────── Bookings & Scheduling ─────────────────────────

model AppointmentSlot {
  id          Int      @id @default(autoincrement())
  branchId    Int      @map("branch_id")
  slotDate    DateTime @map("slot_date") @db.Date
  startTime   String   @map("start_time") @db.VarChar(5)
  endTime     String   @map("end_time") @db.VarChar(5)
  capacity    Int      @default(3)
  bookedCount Int      @default(0) @map("booked_count")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branch       Branch           @relation(fields: [branchId], references: [id])
  slotBookings SlotBooking[]
  bookings     ServiceBooking[]

  @@unique([branchId, slotDate, startTime])
  @@map("appointment_slots")
}

model SlotBooking {
  id        Int      @id @default(autoincrement())
  slotId    Int      @map("slot_id")
  bookingId Int      @unique @map("booking_id")
  createdAt DateTime @default(now()) @map("created_at")

  slot    AppointmentSlot @relation(fields: [slotId], references: [id])
  booking ServiceBooking  @relation(fields: [bookingId], references: [id])

  @@map("slot_bookings")
}

model ServiceBooking {
  id                 Int           @id @default(autoincrement())
  bookingNumber      String        @unique @map("booking_number") @db.VarChar(30)
  bookingType        BookingType   @map("booking_type")
  customerId         Int           @map("customer_id")
  addressId          Int           @map("address_id")
  branchId           Int           @map("branch_id")
  productId          Int?          @map("product_id")
  slotId             Int?          @map("slot_id")
  scheduledDate      DateTime      @map("scheduled_date") @db.Date
  scheduledTime      String?       @map("scheduled_time") @db.VarChar(20)
  problemCategory    String?       @map("problem_category") @db.VarChar(100)
  problemDescription String?       @map("problem_description") @db.VarChar(2000)
  instructions       String?       @db.VarChar(1000)
  status             BookingStatus @default(PENDING_PAYMENT)
  paymentStatus      PaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod      PaymentMethod? @map("payment_method")
  estimatedTotal     Decimal       @default(0) @map("estimated_total") @db.Decimal(12, 2)
  source             BookingSource @default(ADMIN)
  addressSnapshot    Json          @map("address_snapshot")
  amcVisitId         Int?          @unique @map("amc_visit_id")
  completionOtpHash  String?       @map("completion_otp_hash") @db.VarChar(128)
  cancelReason       String?       @map("cancel_reason") @db.VarChar(1000)
  completedAt        DateTime?     @map("completed_at")
  createdById        Int?          @map("created_by_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  customer      Customer               @relation(fields: [customerId], references: [id])
  address       CustomerAddress        @relation(fields: [addressId], references: [id])
  branch        Branch                 @relation(fields: [branchId], references: [id])
  product       Product?               @relation(fields: [productId], references: [id])
  slot          AppointmentSlot?       @relation(fields: [slotId], references: [id])
  amcVisit      AmcVisit?              @relation(fields: [amcVisitId], references: [id])
  items         BookingItem[]
  statusHistory BookingStatusHistory[]
  assignments   TechnicianAssignment[]
  slotBooking   SlotBooking?
  notes         JobNote[]
  attachments   JobAttachment[]
  invoices      Invoice[]
  payments      Payment[]
  reminders     ServiceReminder[]

  @@index([branchId, status])
  @@index([customerId])
  @@index([scheduledDate])
  @@index([createdAt])
  @@map("service_bookings")
}

model BookingItem {
  id          Int         @id @default(autoincrement())
  bookingId   Int         @map("booking_id")
  serviceId   Int         @map("service_id")
  serviceName String      @map("service_name") @db.VarChar(100)
  serviceCode String      @map("service_code") @db.VarChar(30)
  pricingType PricingType @map("pricing_type")
  quantity    Int         @default(1)
  unitPrice   Decimal     @map("unit_price") @db.Decimal(12, 2)
  gstRate     Decimal     @map("gst_rate") @db.Decimal(5, 2)
  lineTotal   Decimal     @map("line_total") @db.Decimal(12, 2)
  isPerformed Boolean     @default(false) @map("is_performed")

  booking ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id])

  @@map("booking_items")
}

model BookingStatusHistory {
  id          Int            @id @default(autoincrement())
  bookingId   Int            @map("booking_id")
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  note        String?        @db.VarChar(1000)
  actorUserId Int?           @map("actor_user_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  booking ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorUserId], references: [id])

  @@index([bookingId])
  @@map("booking_status_history")
}

model TechnicianAssignment {
  id           Int              @id @default(autoincrement())
  bookingId    Int              @map("booking_id")
  staffId      Int              @map("staff_id")
  status       AssignmentStatus @default(ASSIGNED)
  isCurrent    Boolean          @default(true) @map("is_current")
  notes        String?          @db.VarChar(1000)
  rejectReason String?          @map("reject_reason") @db.VarChar(1000)
  assignedById Int?             @map("assigned_by_id")
  assignedAt   DateTime         @default(now()) @map("assigned_at")
  respondedAt  DateTime?        @map("responded_at")
  completedAt  DateTime?        @map("completed_at")

  booking ServiceBooking @relation(fields: [bookingId], references: [id])
  staff   StaffProfile   @relation(fields: [staffId], references: [id])

  @@index([staffId, status])
  @@index([bookingId, isCurrent])
  @@map("technician_assignments")
}

model JobNote {
  id        Int      @id @default(autoincrement())
  bookingId Int      @map("booking_id")
  authorId  Int      @map("author_id")
  note      String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")

  booking ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [authorId], references: [id])

  @@index([bookingId])
  @@map("job_notes")
}

model JobAttachment {
  id           Int            @id @default(autoincrement())
  bookingId    Int            @map("booking_id")
  uploadedById Int            @map("uploaded_by_id")
  kind         AttachmentKind
  filePath     String         @map("file_path") @db.VarChar(500)
  mimeType     String         @map("mime_type") @db.VarChar(100)
  sizeBytes    Int            @map("size_bytes")
  createdAt    DateTime       @default(now()) @map("created_at")

  booking    ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation(fields: [uploadedById], references: [id])

  @@index([bookingId])
  @@map("job_attachments")
}

// ───────────────────────── Finance ─────────────────────────

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(30)
  invoiceDate   DateTime      @default(now()) @map("invoice_date")
  customerId    Int           @map("customer_id")
  branchId      Int           @map("branch_id")
  bookingId     Int?          @map("booking_id")
  amcContractId Int?          @map("amc_contract_id")
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal       @map("taxable_amount") @db.Decimal(12, 2)
  applyGst      Boolean       @default(true) @map("apply_gst")
  isInterState  Boolean       @default(false) @map("is_inter_state")
  cgst          Decimal       @default(0) @db.Decimal(12, 2)
  sgst          Decimal       @default(0) @db.Decimal(12, 2)
  igst          Decimal       @default(0) @db.Decimal(12, 2)
  gstTotal      Decimal       @default(0) @map("gst_total") @db.Decimal(12, 2)
  grandTotal    Decimal       @map("grand_total") @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue    Decimal       @map("balance_due") @db.Decimal(12, 2)
  status        InvoiceStatus @default(ISSUED)
  isFreeService Boolean       @default(false) @map("is_free_service")
  snapshot      Json
  notes         String?       @db.VarChar(1000)
  createdById   Int?          @map("created_by_id")
  cancelledAt   DateTime?     @map("cancelled_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer    Customer        @relation(fields: [customerId], references: [id])
  branch      Branch          @relation(fields: [branchId], references: [id])
  booking     ServiceBooking? @relation(fields: [bookingId], references: [id])
  amcContract AmcContract?    @relation(fields: [amcContractId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]

  @@index([customerId])
  @@index([branchId, invoiceDate])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int      @map("invoice_id")
  serviceId   Int?     @map("service_id")
  stockItemId Int?     @map("stock_item_id")
  description String   @db.VarChar(500)
  hsnSac      String?  @map("hsn_sac") @db.VarChar(20)
  quantity    Int      @default(1)
  rate        Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  gstRate     Decimal  @default(0) @map("gst_rate") @db.Decimal(5, 2)
  amount      Decimal  @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service   Service?   @relation(fields: [serviceId], references: [id])
  stockItem StockItem? @relation(fields: [stockItemId], references: [id])

  @@map("invoice_items")
}

model Payment {
  id               Int                 @id @default(autoincrement())
  paymentNumber    String              @unique @map("payment_number") @db.VarChar(30)
  customerId       Int                 @map("customer_id")
  invoiceId        Int?                @map("invoice_id")
  bookingId        Int?                @map("booking_id")
  amcContractId    Int?                @map("amc_contract_id")
  method           PaymentMethod
  amount           Decimal             @db.Decimal(12, 2)
  status           PaymentRecordStatus @default(PENDING_VERIFICATION)
  referenceNumber  String?             @map("reference_number") @db.VarChar(100)
  proofPath        String?             @map("proof_path") @db.VarChar(500)
  idempotencyKey   String?             @unique @map("idempotency_key") @db.VarChar(100)
  verifiedById     Int?                @map("verified_by_id")
  verifiedAt       DateTime?           @map("verified_at")
  verificationNote String?             @map("verification_note") @db.VarChar(1000)
  receivedAt       DateTime            @default(now()) @map("received_at")
  createdById      Int?                @map("created_by_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  customer     Customer                    @relation(fields: [customerId], references: [id])
  invoice      Invoice?                    @relation(fields: [invoiceId], references: [id])
  booking      ServiceBooking?             @relation(fields: [bookingId], references: [id])
  amcContract  AmcContract?                @relation(fields: [amcContractId], references: [id])
  transactions PaymentGatewayTransaction[]

  @@unique([method, referenceNumber])
  @@index([status])
  @@index([customerId])
  @@map("payments")
}

model PaymentGatewayTransaction {
  id               Int      @id @default(autoincrement())
  provider         String   @default("RAZORPAY") @db.VarChar(20)
  orderId          String   @unique @map("order_id") @db.VarChar(100)
  gatewayPaymentId String?  @unique @map("gateway_payment_id") @db.VarChar(100)
  paymentId        Int?     @map("payment_id")
  customerId       Int      @map("customer_id")
  bookingId        Int?     @map("booking_id")
  invoiceId        Int?     @map("invoice_id")
  amount           Decimal  @db.Decimal(12, 2)
  currency         String   @default("INR") @db.VarChar(3)
  status           String   @db.VarChar(30)
  rawPayload       Json?    @map("raw_payload")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@map("payment_gateway_transactions")
}

/// Append-only. Corrections happen via REVERSAL / ADJUSTMENT entries.
model CustomerLedger {
  id              Int             @id @default(autoincrement())
  customerId      Int             @map("customer_id")
  entryType       LedgerEntryType @map("entry_type")
  referenceType   String?         @map("reference_type") @db.VarChar(30)
  referenceId     Int?            @map("reference_id")
  referenceNumber String?         @map("reference_number") @db.VarChar(30)
  description     String          @db.VarChar(500)
  debit           Decimal         @default(0) @db.Decimal(12, 2)
  credit          Decimal         @default(0) @db.Decimal(12, 2)
  balanceAfter    Decimal         @map("balance_after") @db.Decimal(12, 2)
  entryDate       DateTime        @default(now()) @map("entry_date")
  createdById     Int?            @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, id])
  @@index([entryDate])
  @@map("customer_ledger")
}

// ───────────────────────── AMC ─────────────────────────

model AmcContract {
  id                   Int       @id @default(autoincrement())
  amcNumber            String    @unique @map("amc_number") @db.VarChar(30)
  customerId           Int       @map("customer_id")
  addressId            Int       @map("address_id")
  branchId             Int       @map("branch_id")
  productDetails       String    @map("product_details") @db.VarChar(1000)
  startDate            DateTime  @map("start_date") @db.Date
  endDate              DateTime  @map("end_date") @db.Date
  totalVisits          Int       @map("total_visits")
  visitFrequencyMonths Int       @map("visit_frequency_months")
  contractAmount       Decimal   @map("contract_amount") @db.Decimal(12, 2)
  applyGst             Boolean   @default(true) @map("apply_gst")
  terms                String?   @db.Text
  status               AmcStatus @default(DRAFT)
  createdById          Int?      @map("created_by_id")
  activatedAt          DateTime? @map("activated_at")
  cancelledAt          DateTime? @map("cancelled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  customer  Customer             @relation(fields: [customerId], references: [id])
  address   CustomerAddress      @relation(fields: [addressId], references: [id])
  branch    Branch               @relation(fields: [branchId], references: [id])
  services  AmcContractService[]
  visits    AmcVisit[]
  invoices  Invoice[]
  payments  Payment[]
  reminders ServiceReminder[]

  @@index([status, endDate])
  @@index([customerId])
  @@map("amc_contracts")
}

model AmcContractService {
  amcContractId Int @map("amc_contract_id")
  serviceId     Int @map("service_id")

  amcContract AmcContract @relation(fields: [amcContractId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([amcContractId, serviceId])
  @@map("amc_contract_services")
}

model AmcVisit {
  id            Int            @id @default(autoincrement())
  amcContractId Int            @map("amc_contract_id")
  visitNumber   Int            @map("visit_number")
  scheduledDate DateTime       @map("scheduled_date") @db.Date
  status        AmcVisitStatus @default(SCHEDULED)
  completedAt   DateTime?      @map("completed_at")
  notes         String?        @db.VarChar(1000)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  amcContract AmcContract     @relation(fields: [amcContractId], references: [id])
  booking     ServiceBooking?

  @@unique([amcContractId, visitNumber])
  @@index([scheduledDate, status])
  @@map("amc_visits")
}

// ───────────────────────── Reminders & Notifications ─────────────────────────

model ServiceReminder {
  id             Int            @id @default(autoincrement())
  customerId     Int            @map("customer_id")
  type           ReminderType   @default(SERVICE)
  serviceId      Int?           @map("service_id")
  bookingId      Int?           @map("booking_id")
  amcContractId  Int?           @map("amc_contract_id")
  dueDate        DateTime       @map("due_date") @db.Date
  status         ReminderStatus @default(UPCOMING)
  lastNotifiedAt DateTime?      @map("last_notified_at")
  notifyCount    Int            @default(0) @map("notify_count")
  note           String?        @db.VarChar(1000)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  customer    Customer        @relation(fields: [customerId], references: [id])
  service     Service?        @relation(fields: [serviceId], references: [id])
  booking     ServiceBooking? @relation(fields: [bookingId], references: [id])
  amcContract AmcContract?    @relation(fields: [amcContractId], references: [id])

  @@unique([bookingId, serviceId])
  @@index([dueDate, status])
  @@index([customerId])
  @@map("service_reminders")
}

model Notification {
  id        Int                 @id @default(autoincrement())
  userId    Int                 @map("user_id")
  eventType String              @map("event_type") @db.VarChar(50)
  channel   NotificationChannel @default(IN_APP)
  title     String              @db.VarChar(200)
  body      String              @db.VarChar(2000)
  data      Json?
  status    NotificationStatus  @default(PENDING)
  dedupeKey String?             @unique @map("dedupe_key") @db.VarChar(150)
  attempts  Int                 @default(0)
  lastError String?             @map("last_error") @db.VarChar(1000)
  readAt    DateTime?           @map("read_at")
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, status])
  @@index([status, attempts])
  @@map("notifications")
}

model NotificationTemplate {
  id        Int                 @id @default(autoincrement())
  eventType String              @map("event_type") @db.VarChar(50)
  channel   NotificationChannel
  subject   String?             @db.VarChar(200)
  body      String              @db.Text
  isActive  Boolean             @default(true) @map("is_active")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@unique([eventType, channel])
  @@map("notification_templates")
}

// ───────────────────────── Settings, Sequences, Audit ─────────────────────────

model CompanySetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(50)
  value     Json
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

/// Concurrency-safe document number sequences (LAS-2026-000001 etc.)
model Sequence {
  key   String @id @db.VarChar(50)
  value Int    @default(0)

  @@map("sequences")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  action      String   @db.VarChar(50)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.VarChar(50)
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}
